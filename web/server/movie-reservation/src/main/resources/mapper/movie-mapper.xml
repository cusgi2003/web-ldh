<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="com.korea.movie_reservation.dao.MovieDAO">

	<!-- 1. 영화 등록 -->
	<insert id="insertMovie">
		insert into movie(movie_title, movie_genre, running_time, ticket_price)
		values (
			#{movieTitle},
			#{movieGenre}, 
			#{runningTime},
			#{ticketPrice}
			)
	</insert>
	
	<!-- 영화 단건 조회 -->
	<select id="findMovieById" resultType="MovieVO">
		select * from movie where movie_id = #{movieId}
	</select>

</mapper>